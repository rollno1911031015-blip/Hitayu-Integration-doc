  "keyFeatures": [
    "Shopify order import with duplicate prevention",
    "Round-robin calling team assignment",
    "IVR integration for calling workflows",
    "Multi-gateway payment collection (PayU, Razorpay, Cashfree)",
    "Shiprocket shipment creation, AWB assignment, and tracking",
    "NDR and RTO management",
    "Lead management with followups",
    "WhatsApp and SMS notifications",
    "Inventory management with purchase orders and MRN",
    "Warehouse and vendor management",
    "Role-based access control (RBAC)",
    "Attendance tracking",
    "Abandoned cart recovery",
    "Activity and audit logging",
    "Support ticket management"
  ],
